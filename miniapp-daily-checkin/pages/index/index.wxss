.title {
  font-size: 36rpx;
  font-weight: 700;
}

.desc {
  margin-top: 10rpx;
  color: #6b7280;
}

.highlight {
  color: #4f46e5;
  font-weight: 700;
}

.add-row {
  margin-top: 22rpx;
  display: flex;
  gap: 16rpx;
}

.task-input {
  flex: 1;
  background: #f3f4f6;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  height: 72rpx;
  box-sizing: border-box;
}

.add-btn {
  background: #4f46e5;
  color: #ffffff;
  border-radius: 14rpx;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

.add-btn::after,
.delete-btn::after {
  border: none;
}

.sub-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.task-item:last-child {
  border-bottom: none;
}

.check-btn {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #c7d2fe;
  border-radius: 50%;
  color: #fff;
  text-align: center;
  line-height: 40rpx;
  font-size: 30rpx;
  background: #fff;
}

.check-btn.checked {
  border-color: #4f46e5;
  background: #4f46e5;
}

.task-content {
  flex: 1;
}

.task-title {
  font-size: 30rpx;
}

.task-title.done {
  color: #9ca3af;
  text-decoration: line-through;
}

.task-meta {
  margin-top: 6rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.delete-btn {
  background: #fee2e2;
  color: #b91c1c;
  border-radius: 12rpx;
  font-size: 24rpx;
  padding: 0 18rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.empty {
  text-align: center;
  color: #9ca3af;
}
